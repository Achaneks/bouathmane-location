generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
}

enum CarStatus {
  AVAILABLE
  RENTED
  MAINTENANCE
}

model Car {
  id          String    @id @default(cuid())
  slug        String    @unique
  make        String
  model       String
  year        Int
  description String
  pricePerDay Decimal
  status      CarStatus @default(AVAILABLE)
  images      String[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  rentals     Rental[]
}

model Customer {
  id        String   @id @default(cuid())
  fullName  String
  phone     String
  email     String?
  notes     String?
  createdAt DateTime @default(now())
  rentals   Rental[]
}

enum RentalStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

model Rental {
  id         String       @id @default(cuid())
  carId      String
  car        Car          @relation(fields: [carId], references: [id])
  customerId String
  customer   Customer     @relation(fields: [customerId], references: [id])
  startDate  DateTime
  endDate    DateTime
  totalPrice Decimal
  status     RentalStatus @default(ACTIVE)
  notes      String?
  createdAt  DateTime     @default(now())
}

model Settings {
  id         String @id @default(cuid())
  phone      String
  email      String
  tagline    String
  socialUrls Json   @default("{}")
}
